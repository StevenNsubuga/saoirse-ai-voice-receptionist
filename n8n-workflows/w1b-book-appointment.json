      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst ref = 'RD-' + Date.now().toString().slice(-4);\nconst weekdays = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst months = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nconst d = new Date(b.date + 'T00:00:00');\nconst [hh, mm] = String(b.time || '00:00').split(':').map(Number);\nconst h12 = ((hh + 11) % 12) + 1;\nconst ampm = hh < 12 ? 'in the morning' : (hh < 17 ? 'in the afternoon' : 'in the evening');\nconst spoken = weekdays[d.getDay()] + ' the ' + d.getDate() + ' of ' + months[d.getMonth()] + ' at ' + h12 + (mm ? ':' + String(mm).padStart(2,'0') : \" o'clock\") + ' ' + ampm;\nreturn [{json:{\n  timestamp: new Date().toISOString(),\n  name: b.patient_name || '',\n  phone: b.phone || '',\n  date: b.date || '',\n  time: b.time || '',\n  treatment: b.treatment || '',\n  new_patient: String(b.is_new_patient),\n  ref,\n  status: 'confirmed',\n  booking_ref: ref,\n  spoken_confirmation: 'Booked for ' + spoken\n}}];"
