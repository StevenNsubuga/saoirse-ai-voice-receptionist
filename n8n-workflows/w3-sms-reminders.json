    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "YOUR_CALENDAR_ID@group.calendar.google.com",
          "mode": "list",
          "cachedResultName": "Riverside Dental"
        },
        "returnAll": true,
        "timeMin": "={{ DateTime.now().plus({days:1}).toISODate() }}T00:00:00",
        "timeMax": "={{ DateTime.now().plus({days:2}).toISODate() }}T00:00:00",
        "options": {}
      },
      "id": "e2d56bd2-fd5c-481e-91aa-76a3b038bd99",
      "name": "Tomorrow's Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -656,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse each event's description (format written by W1b) into call variables.\nconst events = $input.all().map(i => i.json).filter(e => e && e.start && e.start.dateTime);\nconst out = [];\nfor (const e of events) {\n  const desc = e.description || '';\n  const phone = (desc.match(/Phone:\\s*(\\+?[\\d\\s-]{7,})/) || [])[1];\n  if (!phone) continue; // no phone, no reminder\n  const name = ((desc.match(/Patient:\\s*(.+)/) || [])[1] || 'the patient').trim();\n  const treatment = ((desc.match(/Treatment:\\s*(.+)/) || [])[1] || 'appointment').trim();\n  const st = new Date(e.start.dateTime);\n  out.push({json:{\n    to_number: phone.replace(/[\\s-]/g, ''),\n    patient_name: name,\n    appointment_date: st.toLocaleDateString('en-IE', {weekday:'long', day:'numeric', month:'long', timeZone:'Europe/Dublin'}),\n    appointment_time: st.toLocaleTimeString('en-IE', {hour:'numeric', minute:'2-digit', timeZone:'Europe/Dublin'}),\n    treatment,\n    event_id: e.id\n  }});\n}\nreturn out;"
      },
      "id": "a55544f6-0723-4b4a-af64-ad9cda8d5977",
      "name": "Parse Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
