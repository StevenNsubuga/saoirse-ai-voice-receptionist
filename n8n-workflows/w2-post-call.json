    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst secret = 'YOUR_ELEVENLABS_WEBHOOK_SECRET';\n\nconst sigHeader = $input.item.json.headers['elevenlabs-signature'];\nif (!sigHeader) throw new Error('Missing signature header');\n\nconst [tPart, vPart] = sigHeader.split(',');\nconst timestamp = tPart.split('=')[1];\nconst signature = vPart.split('=')[1];\n\nif (Math.abs(Date.now()/1000 - Number(timestamp)) > 300) {\n  throw new Error('Webhook timestamp too old');\n}\n\nconst rawBody = Buffer.from($input.item.binary.data.data, 'base64').toString('utf8');\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\n\nif (expected !== signature) throw new Error('Invalid webhook signature');\n\nreturn $input.item;"
      },
