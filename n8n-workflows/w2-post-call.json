    {
      "parameters": {
        "jsCode": "// Redact PPSNs, then extract call summary fields.\n// NOTE: field paths in the ElevenLabs payload can differ by version -\n// after your first real call, open this execution, inspect the Webhook\n// node output, and adjust the paths below if any field comes out empty.\nconst raw = $input.first().json;\nconst p = raw.body || raw;\nconst d = p.data || p;\nconst redact = t => String(t || '')\n  .replace(/\\b\\d{7}\\s?[A-Za-z]{1,2}\\b/g, '[PPSN]')\n  .replace(/\\b(\\d[\\s,.-]?){7}[A-Za-z]{1,2}\\b/g, '[PPSN]');\nconst transcriptArr = Array.isArray(d.transcript) ? d.transcript : [];\nreturn [{json:{\n  timestamp: new Date().toISOString(),\n  direction: d.metadata?.call_direction || d.conversation_initiation_client_data ? 'outbound' : 'inbound',\n  caller_number: d.metadata?.phone_number || d.metadata?.caller_number || 'unknown',\n  duration_secs: d.metadata?.call_duration_secs || 0,\n  outcome: d.analysis?.call_successful || '',\n  summary: redact(d.analysis?.transcript_summary || ''),\n  transcript: redact(transcriptArr.map(t => (t.role || '?') + ': ' + (t.message || '')).join('\\n'))\n}}];"
      },
      "id": "40b17053-e891-432a-8ed3-881247bfc1f2",
